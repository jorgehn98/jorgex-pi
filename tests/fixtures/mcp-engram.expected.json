{
  "schemaVersion": 1,
  "bridge": {
    "capability": "engram-official-bridge-v1",
    "runtimeToolsCapability": "engram-runtime-tools-v1",
    "event": "pi-mcp-adapter:runtime-register:v1",
    "version": 1
  },
  "engramProfile": {
    "tools": [
      "mem_search",
      "mem_context",
      "mem_get_observation",
      "mem_suggest_topic_key",
      "mem_current_project",
      "mem_doctor"
    ],
    "excludedTools": [
      "mem_capture_passive"
    ]
  },
  "server": {
    "name": "engram",
    "args": [
      "mcp",
      "--tools=agent"
    ],
    "lifecycle": "lazy",
    "directTools": false,
    "toolPrefix": "none"
  },
  "context7": {
    "name": "context7",
    "url": "https://mcp.context7.com/mcp",
    "auth": false,
    "lifecycle": "lazy",
    "directTools": false
  }
}
