{
  "schemaVersion": 1,
  "binName": "jorgex-pi",
  "entrypoint": "bin/jorgex-pi.mjs",
  "commands": [
    "status",
    "doctor",
    "models",
    "sync",
    "cleanup"
  ],
  "errorCommand": "unknown",
  "maxStdoutBytes": 65536,
  "exitCodes": {
    "success": 0,
    "unhealthy": 1,
    "usage": 2,
    "internal": 3
  },
  "models": {
    "mode": "managed-primary",
    "primary": {
      "provider": "openai-codex",
      "model": "gpt-5.6-sol",
      "contextWindow": 872000
    },
    "tiers": [
      "strong",
      "standard",
      "cheap"
    ]
  }
}
