{
  "name": "jorgex-pi",
  "version": "0.0.0-development",
  "description": "Pi-native runtime package for the JorgeX harness.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "jorgex"
  ],
  "files": [
    "agents",
    "contract",
    "deferred/agents",
    "extensions",
    "primary",
    "skills",
    "snapshot/agents",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm test",
    "runtime-agents:generate": "node scripts/generate-runtime-agents.mjs",
    "snapshot:generate": "node scripts/generate-snapshot.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/bootstrap.ts"
    ],
    "skills": [
      "./skills/agent-delegation",
      "./skills/deploy-to-vercel",
      "./skills/diagnose",
      "./skills/find-skills",
      "./skills/lean-code",
      "./skills/mcp-builder",
      "./skills/orchestrator",
      "./skills/react-doctor",
      "./skills/skill-creator",
      "./skills/supabase",
      "./skills/supabase-postgres-best-practices",
      "./skills/tdd",
      "./skills/to-issues",
      "./skills/to-prd",
      "./skills/work-lifecycle",
      "./skills/xreview"
    ],
    "prompts": [],
    "themes": []
  },
  "pi-subagents": {
    "agents": [
      "./agents"
    ]
  },
  "bundledDependencies": [
    "@gotgenes/pi-permission-system",
    "@juicesharp/rpiv-ask-user-question",
    "pi-subagents",
    "pi-web-access",
    "@narumitw/pi-goal"
  ],
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2"
  },
  "dependencies": {
    "@gotgenes/pi-permission-system": "27.0.0",
    "@juicesharp/rpiv-ask-user-question": "2.7.0",
    "@narumitw/pi-goal": "0.53.0",
    "pi-subagents": "0.54.0",
    "pi-web-access": "0.24.1"
  }
}
