{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permission": {
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*/.ssh/*": "deny",
      "*/.aws/credentials": "deny",
      "*/.npmrc": "deny",
      "*/.git-credentials": "deny",
      "*/id_rsa": "deny",
      "*/id_ed25519": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "bash": {
      "*": "allow",
      "git rebase": "ask",
      "git rebase *": "ask",
      "git reset --hard": "ask",
      "git reset --hard *": "ask",
      "ssh": "ask",
      "ssh *": "ask",
      "scp": "ask",
      "scp *": "ask",
      "sftp": "ask",
      "sftp *": "ask",
      "rsync": "ask",
      "rsync *": "ask",
      "format": "deny",
      "format *": "deny",
      "*/format": "deny",
      "*/format *": "deny",
      "mkfs": "deny",
      "mkfs *": "deny",
      "*/mkfs": "deny",
      "*/mkfs *": "deny",
      "dd": "deny",
      "dd *": "deny",
      "*/dd": "deny",
      "*/dd *": "deny",
      "shred": "deny",
      "shred *": "deny",
      "*/shred": "deny",
      "*/shred *": "deny",
      "mkfs.*": "deny",
      "*/mkfs.*": "deny"
    },
    "mcp": "allow",
    "skill": "allow",
    "external_directory": "allow",
    "git_read": "allow",
    "ask_user_question": "allow",
    "subagent": "allow",
    "subagent_wait": "allow",
    "contact_supervisor": "allow",
    "web_search": "allow",
    "fetch_content": "allow",
    "get_search_content": "allow",
    "source_check": "allow",
    "goal_blocked": "allow",
    "goal_complete": "allow",
    "goal_wait": "allow",
    "mem_save": "allow",
    "mem_search": "allow",
    "mem_context": "allow",
    "mem_session_summary": "allow",
    "mem_session_start": "allow",
    "mem_session_end": "allow",
    "mem_get_observation": "allow",
    "mem_suggest_topic_key": "allow",
    "mem_save_prompt": "allow",
    "mem_update": "allow",
    "mem_current_project": "allow",
    "mem_judge": "allow",
    "mem_compare": "allow",
    "mem_doctor": "allow",
    "mem_review": "allow",
    "mem_pin": "allow",
    "mem_unpin": "allow"
  }
}
