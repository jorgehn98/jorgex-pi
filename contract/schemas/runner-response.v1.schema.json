{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jorgex.dev/schemas/pi/runner-response.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "ok", "package", "result"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "command": { "enum": ["status", "doctor", "models", "sync", "cleanup", "unknown"] },
    "ok": { "type": "boolean" },
    "package": { "$ref": "#/$defs/package" },
    "result": { "type": "object" },
    "error": { "$ref": "#/$defs/error" }
  },
  "oneOf": [
    {
      "properties": { "command": { "const": "status" }, "ok": { "const": true }, "result": { "$ref": "#/$defs/statusResult" } },
      "not": { "required": ["error"] }
    },
    {
      "properties": { "command": { "const": "status" }, "ok": { "const": false }, "result": { "$ref": "#/$defs/statusResult" } },
      "required": ["error"]
    },
    {
      "properties": { "command": { "const": "doctor" }, "ok": { "const": true }, "result": { "$ref": "#/$defs/doctorResult" } },
      "not": { "required": ["error"] }
    },
    {
      "properties": { "command": { "const": "doctor" }, "ok": { "const": false }, "result": { "$ref": "#/$defs/doctorResult" } },
      "required": ["error"]
    },
    {
      "properties": { "command": { "const": "models" }, "ok": { "const": true }, "result": { "$ref": "#/$defs/modelsResult" } },
      "not": { "required": ["error"] }
    },
    {
      "properties": { "command": { "const": "sync" }, "ok": { "const": true }, "result": { "$ref": "#/$defs/lifecycleResult" } },
      "not": { "required": ["error"] }
    },
    {
      "properties": { "command": { "const": "sync" }, "ok": { "const": false }, "result": { "$ref": "#/$defs/lifecycleResult" } },
      "required": ["error"]
    },
    {
      "properties": { "command": { "const": "cleanup" }, "ok": { "const": true }, "result": { "$ref": "#/$defs/lifecycleResult" } },
      "not": { "required": ["error"] }
    },
    {
      "properties": { "command": { "const": "cleanup" }, "ok": { "const": false }, "result": { "$ref": "#/$defs/lifecycleResult" } },
      "required": ["error"]
    },
    {
      "properties": { "command": { "const": "unknown" }, "ok": { "const": false }, "result": { "$ref": "#/$defs/emptyResult" } },
      "required": ["error"]
    }
  ],
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "root"],
      "properties": {
        "name": { "const": "jorgex-pi" },
        "version": { "type": "string" },
        "root": { "type": "string" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "code", "message"],
      "properties": {
        "phase": { "type": "string" },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "remedy": { "type": "string" }
      }
    },
    "installation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "matches"],
          "properties": {
            "state": { "const": "unregistered" },
            "matches": { "const": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "matches"],
          "properties": {
            "state": { "const": "registered" },
            "matches": { "const": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "matches", "path", "reason"],
          "properties": {
            "state": { "const": "invalid" },
            "matches": { "type": "integer", "minimum": 0 },
            "path": { "type": "string" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "engram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "ownership"],
      "properties": {
        "state": { "enum": ["ready", "missing", "invalid"] },
        "ownership": { "const": "user" },
        "path": { "type": "string" },
        "source": { "enum": ["environment", "path"] },
        "reason": { "type": "string" }
      }
    },
    "statusResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installation", "engram"],
      "properties": {
        "installation": { "$ref": "#/$defs/installation" },
        "engram": { "$ref": "#/$defs/engram" }
      }
    },
    "doctorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthy", "checks"],
      "properties": {
        "healthy": { "type": "boolean" },
        "checks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
              "id": { "enum": ["package", "engram"] },
              "status": { "enum": ["ok", "error"] }
            }
          }
        }
      }
    },
    "modelsResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "primary", "tiers"],
      "properties": {
        "mode": { "const": "managed-primary" },
        "primary": { "$ref": "#/$defs/primaryModel" },
        "tiers": { "const": ["strong", "standard", "cheap"] }
      }
    },
    "primaryModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "contextWindow"],
      "properties": {
        "provider": { "const": "openai-codex" },
        "model": { "const": "gpt-5.6-sol" },
        "contextWindow": { "const": 872000 }
      }
    },
    "lifecycleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed", "actions"],
      "properties": {
        "changed": { "type": "boolean" },
        "actions": {
          "type": "array",
          "maxItems": 9,
          "items": { "$ref": "#/$defs/lifecycleAction" }
        }
      }
    },
    "lifecycleAction": {
      "enum": [
        "created:settings.defaultProvider",
        "created:settings.defaultModel",
        "created:models.providers.openai-codex.modelOverrides.gpt-5.6-sol.contextWindow",
        "released:settings.defaultProvider",
        "released:settings.defaultModel",
        "released:models.providers.openai-codex.modelOverrides.gpt-5.6-sol.contextWindow",
        "removed:settings.defaultProvider",
        "removed:settings.defaultModel",
        "removed:models.providers.openai-codex.modelOverrides.gpt-5.6-sol.contextWindow",
        "created:models.providers",
        "created:models.providers.openai-codex",
        "created:models.providers.openai-codex.modelOverrides",
        "created:models.providers.openai-codex.modelOverrides.gpt-5.6-sol",
        "pruned:models.providers",
        "pruned:models.providers.openai-codex",
        "pruned:models.providers.openai-codex.modelOverrides",
        "pruned:models.providers.openai-codex.modelOverrides.gpt-5.6-sol",
        "created:settings.json",
        "created:models.json",
        "removed:settings.json",
        "removed:models.json"
      ]
    },
    "emptyResult": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    }
  }
}
