{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jorgex.dev/schemas/jorgex-pi/doctor.v1.schema.json",
  "title": "JorgeX Pi doctor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ok", "checks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ok": { "type": "boolean" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "message"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["pass", "warn", "fail"] },
          "message": { "type": "string" },
          "remedy": { "type": "string" }
        }
      }
    }
  }
}
