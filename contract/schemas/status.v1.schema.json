{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jorgex.dev/schemas/jorgex-pi/status.v1.schema.json",
  "title": "JorgeX Pi status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageVersion", "piVersion", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageVersion": { "type": "string" },
    "piVersion": { "type": "string" },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["planned", "audited", "active"] }
        }
      }
    }
  }
}
