{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jorgex.dev/schemas/jorgex-pi/models.v1.schema.json",
  "title": "JorgeX Pi model routing v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "routes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "routes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model"],
        "properties": {
          "model": { "type": "string" },
          "thinking": { "type": "string" }
        }
      }
    }
  }
}
