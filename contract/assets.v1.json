{
  "schemaVersion": 1,
  "manifestVersion": 1,
  "ownership": "package",
  "resources": [
    "DESIGN.md",
    "agents",
    "assets/brand/eye-logo.svg",
    "contract/parity.v1.json",
    "contract/runtime-agents.v1.json",
    "extensions",
    "primary",
    "skills",
    "snapshot/agents",
    "themes"
  ],
  "managedExternalWrites": [
    {
      "owner": "jorgex-pi",
      "root": "PI_CODING_AGENT_DIR",
      "relativePath": "settings.json",
      "semantics": "merge a missing or matching partial defaultProvider=openai-codex and defaultModel=gpt-5.6-sol pair; preserve foreign halves; cleanup removes only receipt-owned exact values"
    },
    {
      "owner": "jorgex-pi",
      "root": "PI_CODING_AGENT_DIR",
      "relativePath": "models.json",
      "semantics": "merge missing providers.openai-codex.modelOverrides.gpt-5.6-sol.contextWindow=872000; cleanup removes only receipt-owned exact values"
    },
    {
      "owner": "jorgex-pi",
      "root": "PI_CODING_AGENT_DIR",
      "relativePath": "jorgex-pi/sol-lifecycle.v1.json",
      "semantics": "record field, container, and file ownership; remove the receipt when empty"
    }
  ],
  "preservedExternalState": [
    {
      "owner": "@gotgenes/pi-permission-system",
      "root": "PI_CODING_AGENT_DIR",
      "relativePath": "extensions/pi-permission-system/config.json"
    },
    {
      "owner": "@gotgenes/pi-permission-system",
      "root": "PI_CODING_AGENT_DIR",
      "relativePath": "extensions/pi-permission-system/logs"
    },
    {
      "owner": "@gotgenes/pi-permission-system",
      "root": "PI_CODING_AGENT_DIR",
      "relativePath": "sessions/permission-forwarding"
    },
    {
      "owner": "@juicesharp/rpiv-ask-user-question",
      "root": "XDG_CONFIG_HOME",
      "relativePath": "rpiv-ask-user-question/config.json"
    },
    {
      "owner": "@juicesharp/rpiv-ask-user-question",
      "root": "HOME",
      "relativePath": ".config/rpiv-ask-user-question/config.json"
    },
    {
      "owner": "pi-web-access",
      "root": "PI_CODING_AGENT_DIR",
      "relativePath": "web-search.json"
    },
    {
      "owner": "pi-web-access",
      "root": "PI_CODING_AGENT_DIR",
      "relativePath": "web-search-cache"
    },
    {
      "owner": "pi-web-access",
      "root": "XDG_CONFIG_HOME",
      "relativePath": "pi/web-search.json"
    },
    {
      "owner": "pi-web-access",
      "root": "XDG_CONFIG_HOME",
      "relativePath": "pi/web-search-cache"
    },
    {
      "owner": "pi-web-access",
      "root": "HOME",
      "relativePath": ".pi/web-search.json"
    },
    {
      "owner": "pi-web-access",
      "root": "HOME",
      "relativePath": ".pi/web-search-cache"
    },
    {
      "owner": "@narumitw/pi-goal",
      "root": "PI_CODING_AGENT_DIR",
      "relativePath": "pi-goal.json"
    },
    {
      "owner": "@narumitw/pi-goal",
      "root": "PI_CODING_AGENT_DIR",
      "relativePath": "pi-goal-state.json"
    },
    {
      "owner": "pi-mcp-adapter",
      "root": "PI_CODING_AGENT_DIR",
      "relativePath": "mcp-cache.json"
    }
  ]
}
